# Copy to .env. Use your actual DNS name, without a scheme or path.
ORBIT_DOMAIN=orbit.example.com
ORBIT_SIGNUP_ENABLED=1
ORBIT_MAX_USERS=100
# Resolve and pin an image digest on your server before a public release.
OLLAMA_IMAGE=ollama/ollama:latest
# Optional local semantic search. Pull this model into your Ollama instance first.
ORBIT_EMBEDDING_MODEL=all-minilm
